{
    "name": "splicewire/laravel-composition-spine",
    "description": "The composition spine's shared Data/DTO + schema authoring vocabulary: generation attributes, the data-schemas projection strategy, the angle layer, the BeatGrammar projector, and the structured-export I/O DTOs with 1:1 hydration. The heavy composition engine stays private; this is the surface satellites and the client share without it.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "galbar/jsonpath": "^3.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "schemastud/laravel-data-schemas": "*",
        "spatie/laravel-data": "^4.0|^5.0",
        "splicewire/laravel-grounding-spine": "*"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Composition\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Composition\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../rushing/laravel-pipeline-registry",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/laravel-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/php-popcorn",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../schemastud/laravel-data-schemas",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../schemastud/php-json-ns",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../splicewire/laravel-grounding-spine",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-grounding-spine.git"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Splicewire\\Composition\\CompositionDataServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    }
}
